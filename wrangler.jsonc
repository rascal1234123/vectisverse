{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vectisverse",
  "compatibility_date": "2026-07-21",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "vectisverse-site-v1"
  },
  "build": {
    "command": "node scripts/build-assets.mjs"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
